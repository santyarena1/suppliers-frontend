  featuredImageUrl      String?
  attachmentUrls        String[]          @default([])
  visibility            Visibility        @default(ALL_AUTHORIZED)
  visibleUserIds        String[]          @default([])
  status                PublicationStatus @default(DRAFT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model BrandCampaign {
  id                   String         @id @default(uuid())
  brandId              String
  brand                BrandAccount   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                 String
  description          String
  startDate            DateTime
  endDate              DateTime
  productIds           String[]       @default([])
  distributorIds       String[]       @default([])
  commercialConditions String?
  attachmentUrls       String[]       @default([])
  visibleUserIds       String[]       @default([])
  status               CampaignStatus @default(DRAFT)
  createdAt            DateTime       @default(now())
}

model BrandMaterial {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        MaterialType
  fileUrl     String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandTraining {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        TrainingType
  contentUrl  String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandFavorite {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId   String
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
}

model BrandNotification {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            BrandAccount?    @relation(fields: [brandId], references: [id])
  type             NotificationType
  title            String
  message          String
  read             Boolean          @default(false)
  relatedProductId String?
  relatedEntityId  String?
  createdAt        DateTime         @default(now())

  @@index([userId, read])
}

model ImportRecord {
  id               String       @id @default(uuid())
  brandId          String
  brand            BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  importedBy       String
  originalFileName String
  storedFileUrl    String?
  importedAt       DateTime     @default(now())
  rowsProcessed    Int          @default(0)
  productsCreated  Int          @default(0)
  productsUpdated  Int          @default(0)
  errorCount       Int          @default(0)
  status           ImportStatus @default(PENDING)
  canRevert        Boolean      @default(false)
  snapshot         Json?

  errors ImportRowError[]
}

model ImportRowError {
  id       String       @id @default(uuid())
  importId String
  import   ImportRecord @relation(fields: [importId], references: [id], onDelete: Cascade)
  row      Int
  column   String?
  message  String
}

model AuditLogEntry {
  id            String        @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedBy   User          @relation(fields: [performedById], references: [id])
  brandId       String?
  brand         BrandAccount? @relation(fields: [brandId], references: [id])
  changes       Json?
  createdAt     DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([brandId])
}

// --- Referencias de precio de venta (locales / retail) ---
// Catálogo propio poblado por ingesta periódica. La UI nunca consulta la fuente
// externa en vivo: siempre lee estas tablas.

model RetailStore {
  id           String   @id @default(uuid())
  /// ID numérico de la tienda en la fuente externa.
  externalId   Int      @unique
  name         String
  logoUrl      String?
  active       Boolean  @default(true)
  /// Algunos locales publican centavos (*100). 100 = dividir al normalizar.
  priceDivisor Int      @default(1)
  raw          Json?
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     RetailProduct[]

  @@index([active, name])
}

model RetailProduct {
  id              String   @id @default(uuid())
  /// ID del producto en la fuente externa.
  externalId      Int      @unique
  storeId         String
  store           RetailStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal  @db.Decimal(14, 4)
  currency        String   @default("ARS")
  productUrl      String?
  imageUrl        String?
  categoryName    String?
  /// Nombre normalizado en minúsculas sin acentos, para búsqueda amplia.
  searchText      String
  active          Boolean  @default(true)
  /// Payload crudo omitido a propósito (pesado); no se persiste en ingest.
  raw             Json?
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  priceHistory    RetailPriceHistory[]

  @@index([storeId])
  @@index([active, price])
  @@index([categoryName])
  @@index([searchText])
  @@index([name])
}

model RetailPriceHistory {
  id              String   @id @default(uuid())
  productId       String
  product         RetailProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ID del cambio en la fuente (si viene).
  externalId      Int?
  previousPrice   Decimal? @db.Decimal(14, 4)
  price           Decimal  @db.Decimal(14, 4)
  changedAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([productId, externalId])
  @@index([productId, changedAt])
}

model RetailIngestRun {
  id               String   @id @default(uuid())
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  /// RUNNING | OK | ERROR | CANCELLED
  status           String   @default("RUNNING")
  /// full | batch
  mode             String   @default("full")
  storesTotal      Int      @default(0)
  storesDone       Int      @default(0)
  productsUpserted Int      @default(0)
  currentStoreName String?
  heartbeatAt      DateTime @default(now())
  errorMessage     String?
}

/// Clave de Serper para rellenar fotos faltantes. Solo superadmin. El secreto
/// va cifrado; nunca se devuelve en claro por la API.
model ImageSyncSettings {
  id                    String   @id @default("default")
  serperApiKeyEncrypted String?
  /// Cron 8:00 y 20:00 America/Argentina/Buenos_Aires.
  cronEnabled           Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

/// Corrida de “Primera foto”: busca en Serper y pisa solo fichas sin imagen.
model ImageSyncRun {
  id           String    @id @default(uuid())
  /// RUNNING | OK | ERROR | CANCELLED
  status       String    @default("RUNNING")
  /// first_photo
  kind         String    @default("first_photo")
  /// manual | cron
  source       String    @default("manual")
  provider     String?
  batchSize    Int       @default(50)
  /// true = una sola tanda; false = todas las faltantes de a `batchSize`
  once         Boolean   @default(false)
  /// Tope de productos de esta corrida (cron). Null = hasta agotar faltantes nuevas.
  maxItems     Int?
  missingTotal Int       @default(0)
  processed    Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  failed       Int       @default(0)
  lastQuery    String?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  heartbeatAt  DateTime  @default(now())
  startedById  String?

  fills ImageSyncFill[]

  @@index([startedAt])
}

/// Una ficha tocada por Primera foto. Unique por producto: si se edita, se actualiza.
model ImageSyncFill {
  id         String          @id @default(uuid())
  runId      String?
  run        ImageSyncRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  productId  String
  product    ProviderSyncCache @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  name       String
  brand      String?
  query      String
  imageUrl   String?
  /// serper | serper_pick | upload
  source     String          @default("serper")
  /// filled | skipped | failed
  status     String
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([productId])
  @@index([createdAt])
  @@index([status])
  @@index([provider])
}

/// Carrito de la organización: lo ven todos los del local y el vendedor del distro.
model OrgCart {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           Json     @default("[]")
  schemes         Json     @default("[]")
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Espacio publicitario. El superadmin los prende y les pone precio.
model AdSlot {
  id               String       @id @default(uuid())
  key              String       @unique
  name             String
  description      String       @default("")
  /// search | home | discovery
  placement        String
  monthlyPriceUsd  Decimal      @db.Decimal(10, 2)
  maxConcurrent    Int          @default(1)
  enabled          Boolean      @default(false)
  campaigns        AdCampaign[]
}

model AdCampaign {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotId    String
  slot      AdSlot           @relation(fields: [slotId], references: [id], onDelete: Restrict)
  status    AdCampaignStatus @default(DRAFT)
  title     String
  subtitle  String           @default("")
  imageUrl  String?
  linkUrl   String?
  articleId String?
  article   NewsArticle?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  events    AdEvent[]

  @@index([tenantId, status])
  @@index([slotId, status])
  @@index([articleId])
}

model AdEvent {
  id         String     @id @default(uuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// impression | click
  kind       String
  path       String?
  createdAt  DateTime   @default(now())

  @@index([campaignId, createdAt])
  @@index([kind, createdAt])
}
