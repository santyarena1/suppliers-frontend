generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Núcleo ----------

enum UserRole {
  ROLE_USER
  ROLE_ADMIN
  ROLE_BRAND
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         UserRole      @default(ROLE_USER)
  active       Boolean       @default(true)
  endDate      DateTime?
  brandId      String?
  brand        BrandAccount? @relation("BrandOwner", fields: [brandId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  savedCredentials Credential[]
  cartItems        CartItem[]
  providerOrders   ProviderOrder[]
  ordersCreated    ProviderOrder[]     @relation("OrderCreatedBy")
  ordersApproved   ProviderOrder[]     @relation("OrderApprovedBy")
  favorites        BrandFavorite[]
  notifications    BrandNotification[]
  accesses         BrandAccess[]       @relation("AccessUser")
  auditLogs        AuditLogEntry[]

  memberships          TenantMembership[]
  managedAccounts      TenantLink[]          @relation("AccountManager")
  productManagerScopes ProductManagerScope[]

  @@index([brandId])
}

// ---------- Organizaciones (multi-tenant) ----------
// Ver docs/ARQUITECTURA_TENANTS.md. El `role` del User es el nivel de plataforma;
// el alcance funcional real lo define la membresía del usuario en una organización.

enum TenantType {
  RETAILER // Cliente tipo 1 — comercio / local
  DISTRIBUTOR // Cliente tipo 2 — proveedor / distribuidor
  BRAND // Cliente tipo 3 — marca
}

enum TenantRole {
  OWNER // Dueño o gerente: control total dentro de su organización
  ADMIN // Administrador operativo delegado
  BUYER // Comprador de un comercio
  SELLER // Vendedor (de comercio o de distribuidor)
  PRODUCT_MANAGER // PM de marcas dentro de un distribuidor
  MARKETING // Marketing de una marca
  COMMERCIAL // Comercial de una marca
  VIEWER // Solo lectura
}

enum TenantLinkStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Cómo se recalcula el IVA. Offline y esquema tienen cada uno el suyo.
/// Sin alícuota original no se aplica (no se inventa 21%, 0% ni 10,5%).
enum IvaAdjustment {
  REMOVE // Descontar el IVA completo
  HALF // Dejar la mitad del IVA de cada producto
  FLAT_10_5 // Normalizar todos los IVA a 10,5%
}

model Tenant {
  id                 String        @id @default(uuid())
  /// Nombre normalizado, es lo único que se muestra en pantalla.
  name               String        @unique
  type               TenantType
  /// Distribuidores con integración por API: clave del proveedor (NEW_BYTES, ELIT…).
  providerKey        String?       @unique
  /// Marcas: cuenta del módulo de Marcas que representa esta organización.
  brandId            String?       @unique
  brand              BrandAccount? @relation("TenantBrand", fields: [brandId], references: [id])
  contactEmail       String?
  contactPhone       String?
  notes              String?
  /// Publicidad paga contratada: habilita que comercios no vinculados la descubran.
  advertisingEnabled Boolean       @default(false)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  memberships   TenantMembership[]
  accessCodes   TenantAccessCode[]
  supplierLinks TenantLink[]          @relation("LinkClient")
  clientLinks   TenantLink[]          @relation("LinkSupplier")
  pmScopes      ProductManagerScope[]
  credentials   Credential[]
  syncConfigs   ProviderSyncConfig[]
  offers        TenantProductOffer[]
  priceHistory  ProductPriceHistory[]
  cartItems     CartItem[]
  orders        ProviderOrder[]
  opsAliases    TenantOpsAlias[]

  @@index([type, active])
}

enum OpsAliasKind {
  ADDRESS
  PAYMENT
  DELIVERY
  WAREHOUSE
}

/// El comercio unifica etiquetas que los distribuidores escriben distinto
/// (misma dirección, mismo medio de pago, etc.) para que el tablero las cuente como una.
model TenantOpsAlias {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      OpsAliasKind
  /// Texto tal como vino en el pedido (la clave cruda del tablero).
  rawKey    String
  groupId   String
  /// Nombre real que eligió el comercio para el grupo.
  label     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, kind, rawKey])
  @@index([tenantId, kind, groupId])
}

enum CatalogAliasKind {
  BRAND
  CATEGORY
  SUBCATEGORY
}

enum CatalogMatchKind {
  EAN
  PART_NUMBER
}

enum CatalogEnrichmentSource {
  MANUAL
  AUTO
  AI
}

/// Término canónico de catálogo (marca, categoría o subcategoría) a nivel plataforma.
model PlatformCatalogTerm {
  id        String           @id @default(uuid())
  kind      CatalogAliasKind
  label     String
  /// Jerarquía: una CATEGORY puede ser padre de SUBCATEGORY (u otra CATEGORY anidada).
  parentId  String?
  parent    PlatformCatalogTerm?  @relation("CatalogTermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  PlatformCatalogTerm[] @relation("CatalogTermTree")
  /// Si false, no se muestra en el catálogo público (grilla de categorías / marcas).
  visible   Boolean          @default(true)
  source    CatalogEnrichmentSource @default(MANUAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  aliases   PlatformCatalogAlias[]

  @@unique([kind, label])
  @@index([kind, visible])
  @@index([parentId])
}

/// Superadmin: vincula valores crudos de distribuidores a un término canónico.
model PlatformCatalogAlias {
  id        String           @id @default(uuid())
  kind      CatalogAliasKind
  /// Vacío = cross-proveedor; set = scoped al distribuidor.
  provider  String           @default("")
  rawKey    String
  groupId   String
  label     String
  termId    String?
  term      PlatformCatalogTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  source    CatalogEnrichmentSource @default(MANUAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([kind, provider, rawKey])
  @@index([kind, groupId])
  @@index([kind, provider])
  @@index([termId])
}

/// Override por producto (traslado / completar marca-categoría sin pelear con el sync).
model PlatformProductCatalogOverride {
  id                 String                  @id @default(uuid())
  provider           String
  externalId         String
  displayBrand       String?
  displayCategory    String?
  displaySubcategory String?
  source             CatalogEnrichmentSource @default(MANUAL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([provider, externalId])
  @@index([provider])
}

/// Superadmin: marca/categoría canónica para todos los productos con el mismo EAN o part number.
model PlatformProductIdentity {
  id                 String                  @id @default(uuid())
  matchKind          CatalogMatchKind
  matchKey           String
  displayBrand       String?
  displayCategory    String?
  displaySubcategory String?
  source             CatalogEnrichmentSource @default(MANUAL)
  confirmedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([matchKind, matchKey])
}

/// Clave de OpenAI para sugerencias de catálogo. Solo superadmin. Cifrada.
model CatalogEnrichmentSettings {
  id                    String   @id @default("default")
  openAiApiKeyEncrypted String?
  updatedAt             DateTime @updatedAt
}

model TenantMembership {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TenantRole
  /// Cargo visible en la interfaz cuando el rol no alcanza para describirlo.
  title     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Única puerta de visibilidad entre organizaciones: un comercio ve a un
/// distribuidor o marca solo si existe este vínculo activo.
model TenantLink {
  id               String           @id @default(uuid())
  clientTenantId   String
  clientTenant     Tenant           @relation("LinkClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  supplierTenantId String
  supplierTenant   Tenant           @relation("LinkSupplier", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  /// Vendedor del proveedor asignado a este cliente (punto de contacto comercial).
  accountManagerId String?
  accountManager   User?            @relation("AccountManager", fields: [accountManagerId], references: [id])
  status           TenantLinkStatus @default(ACTIVE)
  /// Descuento comercial pactado, en porcentaje.
  discountPercent  Decimal?         @db.Decimal(6, 2)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([clientTenantId, supplierTenantId])
  @@index([supplierTenantId, status])
}

/// Código escrito o QR que un distribuidor o marca entrega por fuera de Nodo.
/// El canje no revela la organización de origen hasta completarse.
model TenantAccessCode {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String    @unique
  label     String?
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  redemptions TenantAccessCodeRedemption[]
}

model TenantAccessCodeRedemption {
  id                 String           @id @default(uuid())
  accessCodeId       String
  accessCode         TenantAccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  redeemedByUserId   String
  redeemedByTenantId String
  redeemedAt         DateTime         @default(now())

  @@index([redeemedByTenantId])
}

/// Marcas que un Product Manager controla dentro de su distribuidor.
model ProductManagerScope {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nombre normalizado de la marca tal como se muestra en pantalla.
  brandName String
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, brandName])
}

// La cuenta en el distribuidor es del comercio, no de la persona que la cargó:
// si el encargado de compras se va, la organización sigue comprando. `savedById`
// queda solo como rastro de quién la cargó por última vez.
model Credential {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedById            String?
  savedBy              User?    @relation(fields: [savedById], references: [id], onDelete: SetNull)
  providerName         String
  credentialsEncrypted String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, providerName])
}

// Ficha del producto: lo que el producto *es*. Es igual para toda la plataforma —
// un teclado Logitech tiene el mismo nombre, la misma marca y la misma foto para
// todos. Lo que cambia entre comercios es cuánto cuesta y cuánto hay, y eso vive
// en `TenantProductOffer`.
//
// `raw` guarda la respuesta cruda completa del proveedor para ese producto, así
// ningún dato se pierde aunque hoy no lo mostremos en el frontend.
model ProviderSyncCache {
  id              String   @id @default(uuid())
  provider        String
  externalId      String
  sku             String?
  partNumber      String?
  ean             String?
  name            String
  brand           String?
  category        String?
  subcategory     String?
  description     String?
  longDescription String?
  imageUrl        String?
  productUrl      String?
  locationAir     String?
  warranty        String?
  weight          Decimal? @db.Decimal(10, 3)
  weightUnit      String?
  height          Decimal? @db.Decimal(10, 3)
  width           Decimal? @db.Decimal(10, 3)
  length          Decimal? @db.Decimal(10, 3)
  dimensionsUnit  String?
  volume          Decimal? @db.Decimal(12, 3)
  tags            String?
  raw             Json
  /// Última vez que alguna organización refrescó esta ficha.
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offers     TenantProductOffer[]
  imageFills ImageSyncFill[]

  @@unique([provider, externalId])
  @@index([provider, name])
  @@index([provider, sku])
}

// Lo que un producto cuesta y cuánto hay **para una organización**. Cada comercio
// tiene su propia cuenta en el distribuidor, con su propia lista de precios: dos
// comercios que compran el mismo teclado en el mismo lugar pueden pagar distinto.
//
// Se guarda el valor **crudo** que devolvió el proveedor. El markup y el umbral de
// stock mínimo se aplican al leer, no al escribir: así cambiarlos tiene efecto
// inmediato, es reversible, y la configuración de un comercio no puede alterar lo
// que ve otro.
model TenantProductOffer {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  product     ProviderSyncCache @relation(fields: [provider, externalId], references: [provider, externalId], onDelete: Cascade)
  price       Decimal?          @db.Decimal(14, 4)
  finalPrice  Decimal?          @db.Decimal(14, 4)
  currency    String?
  ivaPercent  Decimal?          @db.Decimal(6, 2)
  stock       Int?
  stockStatus String?
  /// `false` cuando la organización eligió esconder el producto (acción sobre
  /// faltantes o sobre stock cero).
  active      Boolean           @default(true)
  /// Los precios que existían antes de separar ficha y oferta traían el markup
  /// adentro y no hay forma de saber cuál era el crudo. Quedan marcados hasta la
  /// próxima sincronización real.
  needsResync Boolean           @default(false)
  syncedAt    DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider, active])
  @@index([provider, externalId])
}

// Historial real de precio: se graba una fila solo cuando el precio cambia
// respecto de la última sync (no en cada corrida del cron), para tener un
// historial genuino de variaciones y poder graficarlo en la ficha del producto.
model ProductPriceHistory {
  id         String   @id @default(uuid())
  /// El historial es de *tu* precio: cada organización compra con su propia cuenta
  /// y su propia lista, así que la serie de una no dice nada sobre la de otra.
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  price      Decimal? @db.Decimal(14, 4)
  finalPrice Decimal? @db.Decimal(14, 4)
  currency   String?
  capturedAt DateTime @default(now())

  @@index([tenantId, provider, externalId, capturedAt])
}

// Imágenes subidas desde el panel (logos, banners). Se guardan en Postgres
// para que viajen con la DB entre máquinas/deploys (no dependen del disco local).
// La URL pública estable es `/assets/<id>`.
model StoredAsset {
  id        String   @id @default(uuid())
  mimeType  String
  filename  String
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())
}

// Configuración visual + de visibilidad por proveedor, editable desde el
// panel de superadmin. Ausencia de fila para un proveedor = visible, sin
// logo/color custom (se usan los defaults de providerColors.ts).
model ProviderDisplayConfig {
  provider  String   @id
  visible   Boolean  @default(true)
  logoUrl   String?
  textColor String?
  updatedAt DateTime @updatedAt
}

// Excepciones puntuales de acceso a un módulo del sistema para un usuario.
// Ausencia de fila = permitido según el rol (todos los módulos salvo Admin
// para ROLE_USER/ROLE_BRAND). El superadmin puede desactivar módulos por usuario.
model UserModuleAccess {
  id      String  @id @default(uuid())
  userId  String
  module  String
  allowed Boolean @default(true)

  @@unique([userId, module])
}

// Banners de imagen para el home y la landing del buscador, editables desde
// el panel de superadmin. `imageUrl` puede ser URL externa o path `/assets/...`.
model HomeBanner {
  id        String   @id @default(uuid())
  position  String
  /// Slot del grid descontructurado (hero_main, hero_side, tile_1…tile_4, strip).
  slot      String?
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, active, order])
}

/// Identidad visual global de la plataforma (preset de color de marca).
model PlatformSettings {
  id          String   @id @default("platform")
  brandPreset String   @default("violet")
  updatedAt   DateTime @updatedAt
}

enum MissingProductAction {
  KEEP
  OUT_OF_STOCK
  HIDE
  DELETE
}

enum ZeroStockAction {
  KEEP
  HIDE
  DELETE
}

// Configuración de sincronización por organización y proveedor — equivalente a la
// pestaña "Configuración" de cada proveedor en AcuStock. Va junto a la credencial:
// el markup y el umbral de stock son decisiones comerciales del comercio, no de
// quien las cargó.
model ProviderSyncConfig {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String
  enabled              Boolean              @default(false)
  syncIntervalMinutes  Int                  @default(60)
  missingProductAction MissingProductAction @default(KEEP)
  zeroStockAction      ZeroStockAction      @default(KEEP)
  priceMarkupPercent   Decimal              @default(0) @db.Decimal(6, 2)
  // Si el proveedor informa esta cantidad de stock o menos, lo tratamos como
  // sin stock (aplica zeroStockAction). 0 = desactivado. Mismo concepto que
  // el "stock mínimo del proveedor" de AcuStock.
  minStockThreshold    Int                  @default(0)
  /// El comercio (tipo 1) marca si este distribuidor acepta pedido offline (sin facturar).
  acceptsOffline       Boolean              @default(false)
  /// El comercio marca si este distribuidor acepta compra en esquema (facturado, con descuento extra).
  acceptsScheme        Boolean              @default(false)
  /// Obligatorio si acceptsOffline. No se comparte con esquema.
  offlineIvaAdjustment IvaAdjustment?
  /// Obligatorio si acceptsScheme. No se comparte con offline.
  schemeIvaAdjustment  IvaAdjustment?
  /// % extra que informó el vendedor, solo para ítems en esquema (no para sueltos online).
  schemeDiscountPercent Decimal?            @db.Decimal(6, 2)
  lastSyncedAt         DateTime?
  lastSyncError        String?
  lastSyncCreated      Int                  @default(0)
  lastSyncUpdated      Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, provider])
}

// El carrito es personal (dos vendedores del mismo comercio no se pisan) pero
// vive dentro de una organización: si alguien cambia de organización, su carrito
// anterior no lo sigue.
model CartItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  name       String
  price      String
  imageUrl   String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, tenantId, provider, externalId])
  @@index([tenantId])
}

// Borrador de pedido creado en Nodo y enviado al portal del proveedor.
// INVID: el POST de "CONFIRMAR PEDIDO" deja el pedido pendiente.
// NEW_BYTES: POST /carrito/process crea la orden en la cuenta (retiro por defecto).
// `invidOrderNumber` / `invidWebOrderNumber` guardan el nro. externo del proveedor.
model ProviderOrder {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider            String
  status              String
  invidOrderNumber    String?
  invidWebOrderNumber String?
  paymentOption       String
  paymentLabel        String?
  deliveryOption      String?
  deliveryLabel       String?
  notes               String?
  subtotal            Decimal?            @db.Decimal(14, 4)
  impuestos           Decimal?            @db.Decimal(14, 4)
  percepciones        Decimal?            @db.Decimal(14, 4)
  total               Decimal?            @db.Decimal(14, 4)
  errorMessage        String?
  items               Json
  addressSnapshot     Json
  /// ONLINE = checkout al portal. OFFLINE = pedido de Nodo, sin portal, editable.
  channel             String              @default("ONLINE")
  // Aprobación interna del comercio: un vendedor arma el pedido pero no lo
  // confirma; queda en PENDING_APPROVAL hasta que lo aprueba el dueño.
  approvalStatus      OrderApprovalStatus @default(NOT_REQUIRED)
  createdByUserId     String?
  createdBy           User?               @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUserId    String?
  approvedBy          User?               @relation("OrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvalDecidedAt   DateTime?
  rejectionReason     String?
  /// Pedido tal cual lo armó el vendedor. Al aprobarlo se reenvía al proveedor
  /// con estos mismos datos, para que nadie edite lo aprobado por el camino.
  draftInput          Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, provider, createdAt])
  @@index([tenantId, provider, createdAt])
  @@index([tenantId, approvalStatus])
  @@index([approvalStatus])
  @@index([tenantId, channel])
}

enum OrderApprovalStatus {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ---------- Marcas ----------

enum AccessStatus {
  PENDING
  INVITATION_SENT
  ACCEPTED
  ACTIVE
  EXPIRED
  REJECTED
  REVOKED_BY_BRAND
  BLOCKED_BY_ADMIN
}

enum NewsType {
  INCOMING
  LAUNCH
  DISCONTINUED
  WARRANTY_CHANGE
  DISTRIBUTION_CHANGE
  COMMERCIAL_NOTICE
  PRE_SALE
  DELAY
  RECOMMENDED
  IMPORTANT_ALERT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialType {
  BANNER
  IMAGE
  DATASHEET
  CATALOG
  VIDEO
  SOCIAL_TEXT
  PROMOTION
  PRESENTATION
  COMPARISON
  MANUAL
  WARRANTY
  COMMERCIAL
}

enum TrainingType {
  VIDEO
  LINK
  PDF
  COURSE
  SALES_PITCH
  MODEL_COMPARISON
  TECH_DIFFERENTIAL
  CERTIFICATION
  SELLER_MATERIAL
}

enum NotificationType {
  BRAND_INVITATION
  ACCESS_ACTIVATED
  ACCESS_REVOKED
  NEW_LAUNCH
  NEW_INCOMING
  FAVORITE_STATUS_CHANGE
  FAVORITE_DISCONTINUED
  NEW_CAMPAIGN
  NEW_MATERIAL
  NEW_TRAINING
  BRAND_ALERT
}

enum ImportStatus {
  PENDING
  PREVIEW
  PROCESSING
  COMPLETED
  FAILED
  REVERTED
}

enum StockStatus {
  HIGH_STOCK
  MEDIUM_STOCK
  LOW_STOCK
  CRITICAL_STOCK
  OUT_OF_STOCK
  INCOMING
  IN_TRANSIT
  PRE_SALE
  CONSULT
  DISCONTINUED
  SPOT_OFFER
  RECOMMENDED
  COMMERCIAL_PRIORITY
  FEW_UNITS
  DELAYED_ARRIVAL
  REPLACEMENT_AVAILABLE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum Visibility {
  ALL_AUTHORIZED
  SPECIFIC_USERS
}

model BrandAccount {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  description    String?
  commercialData String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  active         Boolean  @default(true)
  suspended      Boolean  @default(false)
  // Visibilidad de la marca para usuarios no-admin, controlada desde el panel
  // de superadmin (distinto de `active`/`suspended`, que son estado de cuenta).
  visible        Boolean  @default(true)
  textColor      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owners        User[]              @relation("BrandOwner")
  distributors  BrandDistributor[]
  products      BrandProduct[]
  accesses      BrandAccess[]
  news          BrandNews[]
  campaigns     BrandCampaign[]
  materials     BrandMaterial[]
  trainings     BrandTraining[]
  imports       ImportRecord[]
  notifications BrandNotification[]
  auditLogs     AuditLogEntry[]
  tenant        Tenant?             @relation("TenantBrand")
}

model Distributor {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  brandLinks     BrandDistributor[]
  availabilities ProductAvailability[]
}

model BrandDistributor {
  id              String       @id @default(uuid())
  brandId         String
  brand           BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  distributorId   String
  distributor     Distributor  @relation(fields: [distributorId], references: [id])
  active          Boolean      @default(true)
  visibleToUsers  Boolean      @default(true)
  commercialNotes String?
  createdAt       DateTime     @default(now())

  @@unique([brandId, distributorId])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  active   Boolean    @default(true)

  products BrandProduct[]
}

model BrandProduct {
  id                      String       @id @default(uuid())
  brandId                 String
  brand                   BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId              String?
  category                Category?    @relation(fields: [categoryId], references: [id])
  subcategoryId           String?
  internalSku             String?
  brandSku                String
  model                   String
  commercialName          String
  eanUpc                  String?
  shortDescription        String?
  technicalDescription    String?
  imageUrls               String[]     @default([])
  datasheetUrl            String?
  generalCommercialStatus String?
  active                  Boolean      @default(true)
  discontinued            Boolean      @default(false)
  isLaunch                Boolean      @default(false)
  recommended             Boolean      @default(false)
  featured                Boolean      @default(false)
  hasReplacement          Boolean      @default(false)
  replacementProductId    String?
  internalNotes           String?
  tags                    String[]     @default([])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  availabilities ProductAvailability[]
  favorites      BrandFavorite[]

  @@unique([brandId, brandSku])
  @@index([brandId, categoryId])
}

model ProductAvailability {
  id                   String       @id @default(uuid())
  productId            String
  product              BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId        String
  distributor          Distributor  @relation(fields: [distributorId], references: [id])
  status               StockStatus
  estimatedQuantity    Int?
  estimatedArrivalDate DateTime?
  notes                String?
  suggestedPrice       Decimal?     @db.Decimal(12, 2)
  commercialAction     String?
  replacementSuggested String?
  commercialPriority   Int?
  tags                 String[]     @default([])
  updatedAt            DateTime     @updatedAt
  updatedBy            String?

  history AvailabilityHistoryEntry[]

  @@unique([productId, distributorId])
}

model AvailabilityHistoryEntry {
  id             String              @id @default(uuid())
  availabilityId String
  availability   ProductAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  previousStatus StockStatus?
  newStatus      StockStatus
  changedBy      String?
  createdAt      DateTime            @default(now())
}

model BrandAccess {
  id             String       @id @default(uuid())
  brandId        String
  brand          BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("AccessUser", fields: [userId], references: [id])
  userEmail      String
  status         AccessStatus @default(PENDING)
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  lastActivityAt DateTime?
  expiresAt      DateTime?
  userGroup      String?
  userTags       String[]     @default([])
  blockedByAdmin Boolean      @default(false)

  @@unique([brandId, userEmail])
}

model BrandNews {
  id                    String            @id @default(uuid())
  brandId               String
  brand                 BrandAccount      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  type                  NewsType
  relatedProductIds     String[]          @default([])
  relatedDistributorIds String[]          @default([])
  publishedAt           DateTime?
  expiresAt             DateTime?
  featuredImageUrl      String?
  attachmentUrls        String[]          @default([])
  visibility            Visibility        @default(ALL_AUTHORIZED)
  visibleUserIds        String[]          @default([])
  status                PublicationStatus @default(DRAFT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model BrandCampaign {
  id                   String         @id @default(uuid())
  brandId              String
  brand                BrandAccount   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                 String
  description          String
  startDate            DateTime
  endDate              DateTime
  productIds           String[]       @default([])
  distributorIds       String[]       @default([])
  commercialConditions String?
  attachmentUrls       String[]       @default([])
  visibleUserIds       String[]       @default([])
  status               CampaignStatus @default(DRAFT)
  createdAt            DateTime       @default(now())
}

model BrandMaterial {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        MaterialType
  fileUrl     String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandTraining {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        TrainingType
  contentUrl  String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandFavorite {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId   String
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
}

model BrandNotification {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            BrandAccount?    @relation(fields: [brandId], references: [id])
  type             NotificationType
  title            String
  message          String
  read             Boolean          @default(false)
  relatedProductId String?
  relatedEntityId  String?
  createdAt        DateTime         @default(now())

  @@index([userId, read])
}

model ImportRecord {
  id               String       @id @default(uuid())
  brandId          String
  brand            BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  importedBy       String
  originalFileName String
  storedFileUrl    String?
  importedAt       DateTime     @default(now())
  rowsProcessed    Int          @default(0)
  productsCreated  Int          @default(0)
  productsUpdated  Int          @default(0)
  errorCount       Int          @default(0)
  status           ImportStatus @default(PENDING)
  canRevert        Boolean      @default(false)
  snapshot         Json?

  errors ImportRowError[]
}

model ImportRowError {
  id       String       @id @default(uuid())
  importId String
  import   ImportRecord @relation(fields: [importId], references: [id], onDelete: Cascade)
  row      Int
  column   String?
  message  String
}

model AuditLogEntry {
  id            String        @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedBy   User          @relation(fields: [performedById], references: [id])
  brandId       String?
  brand         BrandAccount? @relation(fields: [brandId], references: [id])
  changes       Json?
  createdAt     DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([brandId])
}

// --- Referencias de precio de venta (locales / retail) ---
// Catálogo propio poblado por ingesta periódica. La UI nunca consulta la fuente
// externa en vivo: siempre lee estas tablas.

model RetailStore {
  id           String   @id @default(uuid())
  /// ID numérico de la tienda en la fuente externa.
  externalId   Int      @unique
  name         String
  logoUrl      String?
  active       Boolean  @default(true)
  /// Algunos locales publican centavos (*100). 100 = dividir al normalizar.
  priceDivisor Int      @default(1)
  raw          Json?
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     RetailProduct[]

  @@index([active, name])
}

model RetailProduct {
  id              String   @id @default(uuid())
  /// ID del producto en la fuente externa.
  externalId      Int      @unique
  storeId         String
  store           RetailStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal  @db.Decimal(14, 4)
  currency        String   @default("ARS")
  productUrl      String?
  imageUrl        String?
  categoryName    String?
  /// Nombre normalizado en minúsculas sin acentos, para búsqueda amplia.
  searchText      String
  active          Boolean  @default(true)
  /// Payload crudo omitido a propósito (pesado); no se persiste en ingest.
  raw             Json?
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  priceHistory    RetailPriceHistory[]

  @@index([storeId])
  @@index([active, price])
  @@index([categoryName])
  @@index([searchText])
  @@index([name])
}

model RetailPriceHistory {
  id              String   @id @default(uuid())
  productId       String
  product         RetailProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ID del cambio en la fuente (si viene).
  externalId      Int?
  previousPrice   Decimal? @db.Decimal(14, 4)
  price           Decimal  @db.Decimal(14, 4)
  changedAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([productId, externalId])
  @@index([productId, changedAt])
}

model RetailIngestRun {
  id               String   @id @default(uuid())
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  /// RUNNING | OK | ERROR | CANCELLED
  status           String   @default("RUNNING")
  /// full | batch
  mode             String   @default("full")
  storesTotal      Int      @default(0)
  storesDone       Int      @default(0)
  productsUpserted Int      @default(0)
  currentStoreName String?
  heartbeatAt      DateTime @default(now())
  errorMessage     String?
}

/// Clave de Serper para rellenar fotos faltantes. Solo superadmin. El secreto
/// va cifrado; nunca se devuelve en claro por la API.
model ImageSyncSettings {
  id                    String   @id @default("default")
  serperApiKeyEncrypted String?
  /// Cron 8:00 y 20:00 America/Argentina/Buenos_Aires.
  cronEnabled           Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

/// Corrida de “Primera foto”: busca en Serper y pisa solo fichas sin imagen.
model ImageSyncRun {
  id           String    @id @default(uuid())
  /// RUNNING | OK | ERROR | CANCELLED
  status       String    @default("RUNNING")
  /// first_photo
  kind         String    @default("first_photo")
  /// manual | cron
  source       String    @default("manual")
  provider     String?
  batchSize    Int       @default(50)
  /// true = una sola tanda; false = todas las faltantes de a `batchSize`
  once         Boolean   @default(false)
  /// Tope de productos de esta corrida (cron). Null = hasta agotar faltantes nuevas.
  maxItems     Int?
  missingTotal Int       @default(0)
  processed    Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  failed       Int       @default(0)
  lastQuery    String?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  heartbeatAt  DateTime  @default(now())
  startedById  String?

  fills ImageSyncFill[]

  @@index([startedAt])
}

/// Una ficha tocada por Primera foto. Unique por producto: si se edita, se actualiza.
model ImageSyncFill {
  id         String          @id @default(uuid())
  runId      String?
  run        ImageSyncRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  productId  String
  product    ProviderSyncCache @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  name       String
  brand      String?
  query      String
  imageUrl   String?
  /// serper | serper_pick | upload
  source     String          @default("serper")
  /// filled | skipped | failed
  status     String
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([productId])
  @@index([createdAt])
  @@index([status])
  @@index([provider])
}
