generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Núcleo ----------

enum UserRole {
  ROLE_USER
  ROLE_ADMIN
  ROLE_BRAND
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         UserRole      @default(ROLE_USER)
  active       Boolean       @default(true)
  /// Usuario creado por la plataforma (dueño placeholder de una marca del catálogo).
  managedByPlatform Boolean  @default(false)
  endDate      DateTime?
  brandId      String?
  brand        BrandAccount? @relation("BrandOwner", fields: [brandId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  savedCredentials Credential[]
  cartItems        CartItem[]
  providerOrders   ProviderOrder[]
  ordersCreated    ProviderOrder[]     @relation("OrderCreatedBy")
  ordersApproved   ProviderOrder[]     @relation("OrderApprovedBy")
  favorites        BrandFavorite[]
  notifications    BrandNotification[]
  accesses         BrandAccess[]       @relation("AccessUser")
  auditLogs        AuditLogEntry[]

  memberships          TenantMembership[]
  managedAccounts      TenantLink[]          @relation("AccountManager")
  productManagerScopes ProductManagerScope[]
  chatMessages         ChatMessage[]
  chatReads            ChatRead[]
  chatPins             ChatPin[]
  chatReactions        ChatReaction[]
  chatThreadsAsDistro  ChatThread[]          @relation("ChatDistroParticipant")
  chatThreadsAsStore   ChatThread[]          @relation("ChatStoreParticipant")
  tgsSettingsSaved     TgsSettings[]
  newsCreated          NewsArticle[]

  @@index([brandId])
}

// ---------- Organizaciones (multi-tenant) ----------
// Ver docs/ARQUITECTURA_TENANTS.md. El `role` del User es el nivel de plataforma;
// el alcance funcional real lo define la membresía del usuario en una organización.

enum TenantType {
  RETAILER // Cliente tipo 1 — comercio / local
  DISTRIBUTOR // Cliente tipo 2 — proveedor / distribuidor
  BRAND // Cliente tipo 3 — marca
}

enum TenantRole {
  OWNER // Dueño o gerente: control total dentro de su organización
  ADMIN // Administrador operativo delegado
  BUYER // Comprador de un comercio
  SELLER // Vendedor (de comercio o de distribuidor)
  PRODUCT_MANAGER // PM de marcas dentro de un distribuidor
  MARKETING // Marketing de una marca
  COMMERCIAL // Comercial de una marca
  VIEWER // Solo lectura
}

enum TenantLinkStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Cómo se recalcula el IVA. Offline y esquema tienen cada uno el suyo.
/// Sin alícuota original no se aplica (no se inventa 21%, 0% ni 10,5%).
enum IvaAdjustment {
  REMOVE // Descontar el IVA completo
  HALF // Dejar la mitad del IVA de cada producto
  FLAT_10_5 // Normalizar todos los IVA a 10,5%
}

model Tenant {
  id                 String        @id @default(uuid())
  /// Nombre normalizado, es lo único que se muestra en pantalla.
  name               String        @unique
  type               TenantType
  /// Distribuidores con integración por API: clave del proveedor (NEW_BYTES, ELIT…).
  providerKey        String?       @unique
  /// Marcas: cuenta del módulo de Marcas que representa esta organización.
  brandId            String?       @unique
  brand              BrandAccount? @relation("TenantBrand", fields: [brandId], references: [id])
  /// Término canónico de catálogo (kind=BRAND) que esta organización representa.
  catalogTermId      String?       @unique
  catalogTerm        PlatformCatalogTerm? @relation("BrandCatalogTerm", fields: [catalogTermId], references: [id], onDelete: SetNull)
  /// Org creada sola al unificar una marca en el catálogo. El placeholder es el dueño.
  managedByPlatform  Boolean       @default(false)
  contactEmail       String?
  contactPhone       String?
  notes              String?
  /// Publicidad paga contratada: habilita que comercios no vinculados la descubran.
  advertisingEnabled Boolean       @default(false)
  /// Credenciales, vínculos y catálogo se leen de esa organización. Carrito,
  /// pedidos y equipo siguen siendo de esta. Lo usa el superadmin de prueba
  /// para ver lo mismo que testuser1 sin compartir el carrito.
  mirrorsCommercialFromId String?
  mirrorsCommercialFrom   Tenant?  @relation("CommercialMirror", fields: [mirrorsCommercialFromId], references: [id], onDelete: SetNull)
  commercialMirrors       Tenant[] @relation("CommercialMirror")
  /// Proveedores por lista: cada cuántos días se espera una lista nueva. `null` = sin cadencia.
  listUpdateDays     Int?
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  memberships   TenantMembership[]
  accessCodes   TenantAccessCode[]
  supplierLinks TenantLink[]          @relation("LinkClient")
  clientLinks   TenantLink[]          @relation("LinkSupplier")
  pmScopes      ProductManagerScope[]
  credentials   Credential[]
  tgsSettings   TgsSettings?
  syncConfigs   ProviderSyncConfig[]
  catalogSyncRuns CatalogSyncRun[]
  offers        TenantProductOffer[]
  priceHistory  ProductPriceHistory[]
  listImports   SupplierListImport[]
  cartItems     CartItem[]
  orgCart       OrgCart?
  orders        ProviderOrder[]
  opsAliases    TenantOpsAlias[]
  adCampaigns   AdCampaign[]
  brandLanding  BrandLanding?
  brandActions  BrandAction[]
  brandResources BrandResource[]
  brandSignals   BrandSkuSignal[]
  notificationsFrom OrgNotification[] @relation("NotifFrom")
  notificationsTo   OrgNotification[] @relation("NotifTo")
  newsArticles      NewsArticle[]

  @@index([type, active])
  @@index([mirrorsCommercialFromId])
}

enum OpsAliasKind {
  ADDRESS
  PAYMENT
  DELIVERY
  WAREHOUSE
}

/// El comercio unifica etiquetas que los distribuidores escriben distinto
/// (misma dirección, mismo medio de pago, etc.) para que el tablero las cuente como una.
model TenantOpsAlias {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      OpsAliasKind
  /// Texto tal como vino en el pedido (la clave cruda del tablero).
  rawKey    String
  groupId   String
  /// Nombre real que eligió el comercio para el grupo.
  label     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, kind, rawKey])
  @@index([tenantId, kind, groupId])
}

enum CatalogAliasKind {
  BRAND
  CATEGORY
  SUBCATEGORY
}

enum CatalogMatchKind {
  EAN
  PART_NUMBER
}

enum CatalogEnrichmentSource {
  MANUAL
  AUTO
  AI
}

/// Término canónico de catálogo (marca, categoría o subcategoría) a nivel plataforma.
model PlatformCatalogTerm {
  id        String           @id @default(uuid())
  kind      CatalogAliasKind
  label     String
  /// Jerarquía: una CATEGORY puede ser padre de SUBCATEGORY (u otra CATEGORY anidada).
  parentId  String?
  parent    PlatformCatalogTerm?  @relation("CatalogTermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  PlatformCatalogTerm[] @relation("CatalogTermTree")
  /// Si false, no se muestra en el catálogo público (grilla de categorías / marcas).
  visible   Boolean          @default(true)
  /// Si true, aparece en el menú de Nodo (lo arma el admin desde Categorías).
  inMenu    Boolean          @default(false)
  source    CatalogEnrichmentSource @default(MANUAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  aliases   PlatformCatalogAlias[]
  brandTenant Tenant? @relation("BrandCatalogTerm")

  @@unique([kind, label])
  @@index([kind, visible])
  @@index([kind, inMenu])
  @@index([parentId])
}

/// Superadmin: vincula valores crudos de distribuidores a un término canónico.
model PlatformCatalogAlias {
  id        String           @id @default(uuid())
  kind      CatalogAliasKind
  /// Vacío = cross-proveedor; set = scoped al distribuidor.
  provider  String           @default("")
  rawKey    String
  groupId   String
  label     String
  termId    String?
  term      PlatformCatalogTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  source    CatalogEnrichmentSource @default(MANUAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([kind, provider, rawKey])
  @@index([kind, groupId])
  @@index([kind, provider])
  @@index([termId])
}

/// Override por producto (traslado / completar marca-categoría sin pelear con el sync).
model PlatformProductCatalogOverride {
  id                 String                  @id @default(uuid())
  provider           String
  externalId         String
  displayBrand       String?
  displayCategory    String?
  displaySubcategory String?
  source             CatalogEnrichmentSource @default(MANUAL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([provider, externalId])
  @@index([provider])
}

/// Superadmin: marca/categoría canónica para todos los productos con el mismo EAN o part number.
model PlatformProductIdentity {
  id                 String                  @id @default(uuid())
  matchKind          CatalogMatchKind
  matchKey           String
  displayBrand       String?
  displayCategory    String?
  displaySubcategory String?
  source             CatalogEnrichmentSource @default(MANUAL)
  confirmedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([matchKind, matchKey])
}

/// Clave de OpenAI para sugerencias de catálogo. Solo superadmin. Cifrada.
model CatalogEnrichmentSettings {
  id                    String   @id @default("default")
  openAiApiKeyEncrypted String?
  updatedAt             DateTime @updatedAt
}

model TenantMembership {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TenantRole
  /// Cargo visible en la interfaz cuando el rol no alcanza para describirlo.
  title     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Única puerta de visibilidad entre organizaciones: un comercio ve a un
/// distribuidor o marca solo si existe este vínculo activo.
model TenantLink {
  id               String           @id @default(uuid())
  clientTenantId   String
  clientTenant     Tenant           @relation("LinkClient", fields: [clientTenantId], references: [id], onDelete: Cascade)
  supplierTenantId String
  supplierTenant   Tenant           @relation("LinkSupplier", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  /// Vendedor del proveedor asignado a este cliente (punto de contacto comercial).
  accountManagerId String?
  accountManager   User?            @relation("AccountManager", fields: [accountManagerId], references: [id])
  status           TenantLinkStatus @default(ACTIVE)
  /// Descuento comercial pactado, en porcentaje.
  discountPercent  Decimal?         @db.Decimal(6, 2)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  chatThreads ChatThread[]

  @@unique([clientTenantId, supplierTenantId])
  @@index([supplierTenantId, status])
}

/// Código escrito o QR que un distribuidor o marca entrega por fuera de Nodo.
/// El canje no revela la organización de origen hasta completarse.
model TenantAccessCode {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String    @unique
  label     String?
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  redemptions TenantAccessCodeRedemption[]
}

model TenantAccessCodeRedemption {
  id                 String           @id @default(uuid())
  accessCodeId       String
  accessCode         TenantAccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  redeemedByUserId   String
  redeemedByTenantId String
  redeemedAt         DateTime         @default(now())

  @@index([redeemedByTenantId])
}

enum ChatMessageKind {
  TEXT
  IMAGE
  FILE
  ORDER
  PRODUCT
  SYSTEM
}

/// Un hilo entre DOS personas, dentro de un vínculo comercio↔distribuidor.
/// El vendedor no ve el chat del PM; el dueño del local no ve el del comprador.
model ChatThread {
  id            String   @id @default(uuid())
  linkId        String
  link          TenantLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  distroUserId  String
  distroUser    User     @relation("ChatDistroParticipant", fields: [distroUserId], references: [id], onDelete: Cascade)
  storeUserId   String
  storeUser     User     @relation("ChatStoreParticipant", fields: [storeUserId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]
  reads    ChatRead[]
  pins     ChatPin[]

  @@unique([linkId, distroUserId, storeUserId])
  @@index([distroUserId])
  @@index([storeUserId])
  @@index([linkId])
}

model ChatMessage {
  id           String          @id @default(uuid())
  threadId     String
  thread       ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String?
  author       User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  kind         ChatMessageKind @default(TEXT)
  body         String          @default("")
  payload      Json?
  replyToId    String?
  replyTo      ChatMessage?    @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]   @relation("ChatReply")
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())

  pins      ChatPin[]
  reactions ChatReaction[]

  @@index([threadId, createdAt])
  @@index([authorUserId])
}

/// Un emoji por persona por mensaje. Toggle: el mismo otra vez lo saca.
model ChatReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([messageId])
}

model ChatRead {
  threadId   String
  userId     String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime
  @@id([threadId, userId])
}

model ChatPin {
  threadId   String
  messageId  String
  pinnedById String
  thread     ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  @@id([threadId, messageId])
}

/// Marcas que un Product Manager controla dentro de su distribuidor.
model ProductManagerScope {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nombre normalizado de la marca tal como se muestra en pantalla.
  brandName String
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, brandName])
}

// La cuenta en el distribuidor es del comercio, no de la persona que la cargó:
// si el encargado de compras se va, la organización sigue comprando. `savedById`
// queda solo como rastro de quién la cargó por última vez.
model Credential {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedById            String?
  savedBy              User?    @relation(fields: [savedById], references: [id], onDelete: SetNull)
  providerName         String
  credentialsEncrypted String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, providerName])
}

/// Claves de AcuStock del comercio TGS. Cifradas; el front nunca las vuelve a ver.
model TgsSettings {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeyEncrypted    String?
  apiSecretEncrypted String?
  baseUrl            String?
  savedById          String?
  savedBy            User?    @relation(fields: [savedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Ficha del producto: lo que el producto *es*. Es igual para toda la plataforma —
// un teclado Logitech tiene el mismo nombre, la misma marca y la misma foto para
// todos. Lo que cambia entre comercios es cuánto cuesta y cuánto hay, y eso vive
// en `TenantProductOffer`.
//
// `raw` guarda la respuesta cruda completa del proveedor para ese producto, así
// ningún dato se pierde aunque hoy no lo mostremos en el frontend.
model ProviderSyncCache {
  id              String   @id @default(uuid())
  provider        String
  externalId      String
  sku             String?
  partNumber      String?
  ean             String?
  name            String
  brand           String?
  category        String?
  subcategory     String?
  description     String?
  longDescription String?
  imageUrl        String?
  productUrl      String?
  locationAir     String?
  warranty        String?
  weight          Decimal? @db.Decimal(10, 3)
  weightUnit      String?
  height          Decimal? @db.Decimal(10, 3)
  width           Decimal? @db.Decimal(10, 3)
  length          Decimal? @db.Decimal(10, 3)
  dimensionsUnit  String?
  volume          Decimal? @db.Decimal(12, 3)
  tags            String?
  raw             Json
  /// Última vez que alguna organización refrescó esta ficha.
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offers     TenantProductOffer[]
  imageFills ImageSyncFill[]

  @@unique([provider, externalId])
  @@index([provider, name])
  @@index([provider, sku])
}

// Lo que un producto cuesta y cuánto hay **para una organización**. Cada comercio
// tiene su propia cuenta en el distribuidor, con su propia lista de precios: dos
// comercios que compran el mismo teclado en el mismo lugar pueden pagar distinto.
//
// Se guarda el valor **crudo** que devolvió el proveedor. El markup y el umbral de
// stock mínimo se aplican al leer, no al escribir: así cambiarlos tiene efecto
// inmediato, es reversible, y la configuración de un comercio no puede alterar lo
// que ve otro.
model TenantProductOffer {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String
  product     ProviderSyncCache @relation(fields: [provider, externalId], references: [provider, externalId], onDelete: Cascade)
  price       Decimal?          @db.Decimal(14, 4)
  finalPrice  Decimal?          @db.Decimal(14, 4)
  currency    String?
  ivaPercent  Decimal?          @db.Decimal(6, 2)
  stock       Int?
  stockStatus String?
  /// `false` cuando la organización eligió esconder el producto (acción sobre
  /// faltantes o sobre stock cero).
  active      Boolean           @default(true)
  /// Los precios que existían antes de separar ficha y oferta traían el markup
  /// adentro y no hay forma de saber cuál era el crudo. Quedan marcados hasta la
  /// próxima sincronización real.
  needsResync Boolean           @default(false)
  /// De dónde salió esta oferta: sync por API, lista propia del comercio o lista base del proveedor.
  source      OfferSource       @default(SYNC)
  syncedAt    DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider, active])
  @@index([provider, externalId])
}

// Historial real de precio: se graba una fila solo cuando el precio cambia
// respecto de la última sync (no en cada corrida del cron), para tener un
// historial genuino de variaciones y poder graficarlo en la ficha del producto.
model ProductPriceHistory {
  id         String   @id @default(uuid())
  /// El historial es de *tu* precio: cada organización compra con su propia cuenta
  /// y su propia lista, así que la serie de una no dice nada sobre la de otra.
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  price      Decimal? @db.Decimal(14, 4)
  finalPrice Decimal? @db.Decimal(14, 4)
  currency   String?
  capturedAt DateTime @default(now())

  @@index([tenantId, provider, externalId, capturedAt])
}

// ---------- Importación de listas de precios (proveedores por lista) ----------

enum OfferSource {
  SYNC // Sync por API / portal del proveedor
  OWN_LIST // Lista que subió el propio comercio: sus precios
  BASE_LIST // Lista base del proveedor, materializada para cada comercio vinculado
}

enum ImportProfileStatus {
  PROPOSED
  ACTIVE
  ARCHIVED
}

enum ImportNumberFormat {
  DOT // 1234.50
  COMMA // 1.234,50
}

enum ImportDividerMeaning {
  BRAND
  CATEGORY
  IGNORE
}

enum ListImportLevel {
  BASE // Precio base del proveedor (lo sube el proveedor o superadmin)
  TENANT // Precios propios de un comercio
}

enum ListImportStatus {
  PROCESSING
  NEEDS_REVIEW
  APPLIED
  DISCARDED
  REVERTED
  FAILED
}

// Precio y stock **base** de un proveedor por lista: lo que el proveedor mismo
// (o el superadmin) informó. Se materializa en TenantProductOffer (source
// BASE_LIST) para cada comercio vinculado, así todos los caminos de lectura
// siguen funcionando igual que con un sync por API.
model SupplierBaseOffer {
  id          String   @id @default(uuid())
  provider    String
  externalId  String
  price       Decimal? @db.Decimal(14, 4)
  finalPrice  Decimal? @db.Decimal(14, 4)
  currency    String?
  ivaPercent  Decimal? @db.Decimal(6, 2)
  stock       Int?
  stockStatus String?
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([provider, syncedAt])
}

// Cómo se lee la planilla de un proveedor: qué hoja, en qué fila está el
// encabezado, qué columna es cada campo, moneda, IVA, formato numérico y qué
// significan las filas divisorias. Se aprende una vez (IA o a mano) y se
// reutiliza mientras la huella del archivo coincida. Cada guardado es una versión.
model ImportProfile {
  id               String               @id @default(uuid())
  provider         String
  version          Int                  @default(1)
  status           ImportProfileStatus  @default(PROPOSED)
  /// Hash de encabezados normalizados + cantidad de hojas.
  fingerprint      String
  /// Encabezados normalizados, para coincidencia parcial.
  headers          Json
  sheetIndex       Int                  @default(0)
  sheetName        String?
  headerRow        Int                  @default(0)
  /// { "<encabezado original>": "<campo NormalizedProduct>" | null }
  columnMap        Json
  currency         String?
  priceIncludesIva Boolean              @default(false)
  ivaPercent       Decimal?             @db.Decimal(6, 2)
  numberFormat     ImportNumberFormat   @default(COMMA)
  dividerMeaning   ImportDividerMeaning @default(IGNORE)
  /// Primeras filas crudas de la planilla con la que se creó, para el editor.
  sampleRows       Json?
  proposedByAi     Boolean              @default(false)
  aiReasoning      String?
  approvedByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  imports SupplierListImport[]

  @@index([provider, status])
  @@index([provider, fingerprint])
}

// Una planilla subida. Termina siempre en un estado visible.
model SupplierListImport {
  id               String           @id @default(uuid())
  provider         String
  /// Organización desde la que se subió (comercio, proveedor o la del superadmin).
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  level            ListImportLevel
  originalFileName String
  storedAssetId    String?
  profileId        String?
  profile          ImportProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status           ListImportStatus @default(PROCESSING)
  rowsTotal        Int              @default(0)
  rowsData         Int              @default(0)
  /// { created, priceChanged, unchanged, missing, issues }
  summary          Json?
  /// Motivos por los que quedó en revisión (texto para humanos).
  reviewReasons    Json?
  /// Muestras por grupo del diff, para la pantalla de revisión.
  diff             Json?
  /// Filas normalizadas listas para aplicar (se conservan hasta aplicar/descartar).
  normalizedRows   Json?
  /// Ofertas previas afectadas, para revertir.
  snapshot         Json?
  error            String?
  createdAt        DateTime         @default(now())
  appliedAt        DateTime?
  revertedAt       DateTime?

  issues ImportRowIssue[]

  @@index([provider, level, status, createdAt])
  @@index([tenantId, createdAt])
}

model ImportRowIssue {
  id       String             @id @default(uuid())
  importId String
  import   SupplierListImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  row      Int
  column   String?
  message  String

  @@index([importId])
}

