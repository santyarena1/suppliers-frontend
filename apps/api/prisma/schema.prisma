generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Núcleo ----------

enum UserRole {
  ROLE_USER
  ROLE_ADMIN
  ROLE_BRAND
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ROLE_USER)
  active       Boolean   @default(true)
  endDate      DateTime?
  brandId      String?
  brand        BrandAccount? @relation("BrandOwner", fields: [brandId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  credentials   Credential[]
  cartItems     CartItem[]
  favorites     BrandFavorite[]
  notifications BrandNotification[]
  accesses      BrandAccess[]        @relation("AccessUser")
  auditLogs     AuditLogEntry[]

  @@index([brandId])
}

model Credential {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerName        String
  credentialsEncrypted String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, providerName])
}

// Catálogo completo de cada proveedor, sincronizado en background (no se
// consulta la API del proveedor en cada búsqueda de usuario). Los campos
// normalizados son para poder buscar/filtrar rápido; `raw` guarda la
// respuesta cruda completa del proveedor para ese producto, así ningún
// dato se pierde aunque hoy no lo mostremos en el frontend.
model ProviderSyncCache {
  id          String    @id @default(uuid())
  provider    String
  externalId  String
  sku         String?
  partNumber  String?
  ean         String?
  name        String
  brand       String?
  category    String?
  subcategory String?
  description String?
  longDescription String?
  price       Decimal?  @db.Decimal(14, 4)
  finalPrice  Decimal?  @db.Decimal(14, 4)
  currency    String?
  ivaPercent  Decimal?  @db.Decimal(6, 2)
  stock       Int?
  stockStatus String?
  imageUrl    String?
  productUrl  String?
  locationAir String?
  warranty    String?
  weight      Decimal?  @db.Decimal(10, 3)
  weightUnit  String?
  height      Decimal?  @db.Decimal(10, 3)
  width       Decimal?  @db.Decimal(10, 3)
  length      Decimal?  @db.Decimal(10, 3)
  dimensionsUnit String?
  volume      Decimal?  @db.Decimal(12, 3)
  tags        String?
  active      Boolean   @default(true)
  raw         Json
  syncedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([provider, name])
  @@index([provider, sku])
}

enum MissingProductAction {
  KEEP
  OUT_OF_STOCK
  HIDE
  DELETE
}

enum ZeroStockAction {
  KEEP
  HIDE
  DELETE
}

// Configuración de sincronización por usuario y proveedor — equivalente a la
// pestaña "Configuración" de cada proveedor en AcuStock.
model ProviderSyncConfig {
  id                    String                @id @default(uuid())
  userId                String
  provider              String
  enabled               Boolean               @default(false)
  syncIntervalMinutes   Int                   @default(60)
  missingProductAction  MissingProductAction  @default(KEEP)
  zeroStockAction       ZeroStockAction       @default(KEEP)
  priceMarkupPercent    Decimal               @default(0) @db.Decimal(6, 2)
  // Si el proveedor informa esta cantidad de stock o menos, lo tratamos como
  // sin stock (aplica zeroStockAction). 0 = desactivado. Mismo concepto que
  // el "stock mínimo del proveedor" de AcuStock.
  minStockThreshold    Int                   @default(0)
  lastSyncedAt          DateTime?
  lastSyncError         String?
  lastSyncCreated       Int                   @default(0)
  lastSyncUpdated       Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([userId, provider])
}

model CartItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  name       String
  price      String
  imageUrl   String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, provider, externalId])
}

// ---------- Marcas ----------

enum AccessStatus {
  PENDING
  INVITATION_SENT
  ACCEPTED
  ACTIVE
  EXPIRED
  REJECTED
  REVOKED_BY_BRAND
  BLOCKED_BY_ADMIN
}

enum NewsType {
  INCOMING
  LAUNCH
  DISCONTINUED
  WARRANTY_CHANGE
  DISTRIBUTION_CHANGE
  COMMERCIAL_NOTICE
  PRE_SALE
  DELAY
  RECOMMENDED
  IMPORTANT_ALERT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialType {
  BANNER
  IMAGE
  DATASHEET
  CATALOG
  VIDEO
  SOCIAL_TEXT
  PROMOTION
  PRESENTATION
  COMPARISON
  MANUAL
  WARRANTY
  COMMERCIAL
}

enum TrainingType {
  VIDEO
  LINK
  PDF
  COURSE
  SALES_PITCH
  MODEL_COMPARISON
  TECH_DIFFERENTIAL
  CERTIFICATION
  SELLER_MATERIAL
}

enum NotificationType {
  BRAND_INVITATION
  ACCESS_ACTIVATED
  ACCESS_REVOKED
  NEW_LAUNCH
  NEW_INCOMING
  FAVORITE_STATUS_CHANGE
  FAVORITE_DISCONTINUED
  NEW_CAMPAIGN
  NEW_MATERIAL
  NEW_TRAINING
  BRAND_ALERT
}

enum ImportStatus {
  PENDING
  PREVIEW
  PROCESSING
  COMPLETED
  FAILED
  REVERTED
}

enum StockStatus {
  HIGH_STOCK
  MEDIUM_STOCK
  LOW_STOCK
  CRITICAL_STOCK
  OUT_OF_STOCK
  INCOMING
  IN_TRANSIT
  PRE_SALE
  CONSULT
  DISCONTINUED
  SPOT_OFFER
  RECOMMENDED
  COMMERCIAL_PRIORITY
  FEW_UNITS
  DELAYED_ARRIVAL
  REPLACEMENT_AVAILABLE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum Visibility {
  ALL_AUTHORIZED
  SPECIFIC_USERS
}

model BrandAccount {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  description    String?
  commercialData String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  active         Boolean  @default(true)
  suspended      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owners        User[]              @relation("BrandOwner")
  distributors  BrandDistributor[]
  products      BrandProduct[]
  accesses      BrandAccess[]
  news          BrandNews[]
  campaigns     BrandCampaign[]
  materials     BrandMaterial[]
  trainings     BrandTraining[]
  imports       ImportRecord[]
  notifications BrandNotification[]
  auditLogs     AuditLogEntry[]
}

model Distributor {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  brandLinks     BrandDistributor[]
  availabilities ProductAvailability[]
}

model BrandDistributor {
  id               String      @id @default(uuid())
  brandId          String
  brand            BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  distributorId    String
  distributor      Distributor @relation(fields: [distributorId], references: [id])
  active           Boolean     @default(true)
  visibleToUsers   Boolean     @default(true)
  commercialNotes  String?
  createdAt        DateTime    @default(now())

  @@unique([brandId, distributorId])
}

model Category {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  active   Boolean @default(true)

  products BrandProduct[]
}

model BrandProduct {
  id                        String   @id @default(uuid())
  brandId                   String
  brand                     BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId                String?
  category                  Category? @relation(fields: [categoryId], references: [id])
  subcategoryId             String?
  internalSku               String?
  brandSku                  String
  model                     String
  commercialName            String
  eanUpc                    String?
  shortDescription          String?
  technicalDescription      String?
  imageUrls                 String[] @default([])
  datasheetUrl              String?
  generalCommercialStatus   String?
  active                    Boolean  @default(true)
  discontinued              Boolean  @default(false)
  isLaunch                  Boolean  @default(false)
  recommended               Boolean  @default(false)
  featured                  Boolean  @default(false)
  hasReplacement            Boolean  @default(false)
  replacementProductId      String?
  internalNotes             String?
  tags                      String[] @default([])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  availabilities ProductAvailability[]
  favorites      BrandFavorite[]

  @@unique([brandId, brandSku])
  @@index([brandId, categoryId])
}

model ProductAvailability {
  id                   String      @id @default(uuid())
  productId            String
  product              BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributorId        String
  distributor          Distributor @relation(fields: [distributorId], references: [id])
  status               StockStatus
  estimatedQuantity    Int?
  estimatedArrivalDate DateTime?
  notes                String?
  suggestedPrice       Decimal?    @db.Decimal(12, 2)
  commercialAction     String?
  replacementSuggested String?
  commercialPriority   Int?
  tags                 String[]    @default([])
  updatedAt            DateTime    @updatedAt
  updatedBy            String?

  history AvailabilityHistoryEntry[]

  @@unique([productId, distributorId])
}

model AvailabilityHistoryEntry {
  id             String   @id @default(uuid())
  availabilityId String
  availability   ProductAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  previousStatus StockStatus?
  newStatus      StockStatus
  changedBy      String?
  createdAt      DateTime @default(now())
}

model BrandAccess {
  id               String       @id @default(uuid())
  brandId          String
  brand            BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation("AccessUser", fields: [userId], references: [id])
  userEmail        String
  status           AccessStatus @default(PENDING)
  invitedAt        DateTime     @default(now())
  acceptedAt       DateTime?
  lastActivityAt   DateTime?
  expiresAt        DateTime?
  userGroup        String?
  userTags         String[]     @default([])
  blockedByAdmin   Boolean      @default(false)

  @@unique([brandId, userEmail])
}

model BrandNews {
  id                    String            @id @default(uuid())
  brandId               String
  brand                 BrandAccount      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  type                  NewsType
  relatedProductIds     String[]          @default([])
  relatedDistributorIds String[]          @default([])
  publishedAt           DateTime?
  expiresAt             DateTime?
  featuredImageUrl      String?
  attachmentUrls        String[]          @default([])
  visibility            Visibility        @default(ALL_AUTHORIZED)
  visibleUserIds        String[]          @default([])
  status                PublicationStatus @default(DRAFT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model BrandCampaign {
  id                     String         @id @default(uuid())
  brandId                String
  brand                  BrandAccount   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                   String
  description            String
  startDate              DateTime
  endDate                DateTime
  productIds             String[]       @default([])
  distributorIds         String[]       @default([])
  commercialConditions   String?
  attachmentUrls         String[]       @default([])
  visibleUserIds         String[]       @default([])
  status                 CampaignStatus @default(DRAFT)
  createdAt              DateTime       @default(now())
}

model BrandMaterial {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        MaterialType
  fileUrl     String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandTraining {
  id          String       @id @default(uuid())
  brandId     String
  brand       BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  type        TrainingType
  contentUrl  String
  productIds  String[]     @default([])
  description String?
  createdAt   DateTime     @default(now())
}

model BrandFavorite {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   BrandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId   String
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
}

model BrandNotification {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            BrandAccount?     @relation(fields: [brandId], references: [id])
  type             NotificationType
  title            String
  message          String
  read             Boolean           @default(false)
  relatedProductId String?
  relatedEntityId  String?
  createdAt        DateTime          @default(now())

  @@index([userId, read])
}

model ImportRecord {
  id               String       @id @default(uuid())
  brandId          String
  brand            BrandAccount @relation(fields: [brandId], references: [id], onDelete: Cascade)
  importedBy       String
  originalFileName String
  storedFileUrl    String?
  importedAt       DateTime     @default(now())
  rowsProcessed    Int          @default(0)
  productsCreated  Int          @default(0)
  productsUpdated  Int          @default(0)
  errorCount       Int          @default(0)
  status           ImportStatus @default(PENDING)
  canRevert        Boolean      @default(false)
  snapshot         Json?

  errors ImportRowError[]
}

model ImportRowError {
  id       String        @id @default(uuid())
  importId String
  import   ImportRecord  @relation(fields: [importId], references: [id], onDelete: Cascade)
  row      Int
  column   String?
  message  String
}

model AuditLogEntry {
  id              String       @id @default(uuid())
  entityType      String
  entityId        String
  action          String
  performedById   String
  performedBy     User         @relation(fields: [performedById], references: [id])
  brandId         String?
  brand           BrandAccount? @relation(fields: [brandId], references: [id])
  changes         Json?
  createdAt       DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([brandId])
}
