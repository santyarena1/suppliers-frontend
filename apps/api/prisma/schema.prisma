enum MissingProductAction {
  KEEP
  OUT_OF_STOCK
  HIDE
  DELETE
}

enum ZeroStockAction {
  KEEP
  HIDE
  DELETE
}

// Configuración de sincronización por organización y proveedor — equivalente a la
// pestaña "Configuración" de cada proveedor en AcuStock. Va junto a la credencial:
// el markup y el umbral de stock son decisiones comerciales del comercio, no de
// quien las cargó.
model ProviderSyncConfig {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String
  enabled              Boolean              @default(false)
  syncIntervalMinutes  Int                  @default(60)
  missingProductAction MissingProductAction @default(KEEP)
  zeroStockAction      ZeroStockAction      @default(KEEP)
  priceMarkupPercent   Decimal              @default(0) @db.Decimal(6, 2)
  // Si el proveedor informa esta cantidad de stock o menos, lo tratamos como
  // sin stock (aplica zeroStockAction). 0 = desactivado. Mismo concepto que
  // el "stock mínimo del proveedor" de AcuStock.
  minStockThreshold    Int                  @default(0)
  /// El comercio (tipo 1) marca si este distribuidor acepta pedido offline (sin facturar).
  acceptsOffline       Boolean              @default(false)
  /// El comercio marca si este distribuidor acepta compra en esquema (facturado, con descuento extra).
  acceptsScheme        Boolean              @default(false)
  /// Obligatorio si acceptsOffline. No se comparte con esquema.
  offlineIvaAdjustment IvaAdjustment?
  /// Obligatorio si acceptsScheme. No se comparte con offline.
  schemeIvaAdjustment  IvaAdjustment?
  /// % extra que informó el vendedor, solo para ítems en esquema (no para sueltos online).
  schemeDiscountPercent Decimal?            @db.Decimal(6, 2)
  lastSyncedAt         DateTime?
  lastSyncError        String?
  lastSyncCreated      Int                  @default(0)
  lastSyncUpdated      Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, provider])
}

/// Una corrida de sincronización de catálogo (API, cron o Excel) de un
/// proveedor para una organización. El POST de sync sigue siendo bloqueante;
/// esta fila se actualiza en cada tanda para que el front pueda pollear avance.
model CatalogSyncRun {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String
  /// RUNNING | OK | ERROR
  status             String   @default("RUNNING")
  /// manual | cron | import
  source             String   @default("manual")
  processed          Int      @default(0)
  created            Int      @default(0)
  updated            Int      @default(0)
  unchanged          Int      @default(0)
  missingAffected    Int      @default(0)
  zeroStockAffected  Int      @default(0)
  /// Ofertas que había al empezar: sirve de denominador de la barra. En el
  /// primer sync es 0 y el front muestra conteo sin porcentaje.
  expectedTotal      Int      @default(0)
  /// Filas de CatalogSyncChange realmente guardadas (tope, no el total).
  changesStored      Int      @default(0)
  changesTruncated   Boolean  @default(false)
  errorMessage       String?
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  heartbeatAt        DateTime @default(now())

  changes CatalogSyncChange[]

  @@index([tenantId, provider, startedAt])
  @@index([tenantId, provider, status])
}

/// Alta o cambio relevante de un producto dentro de una corrida. No se
/// guardan los unchanged. Hay un tope por corrida para no inflar la DB.
model CatalogSyncChange {
  id            String         @id @default(uuid())
  runId         String
  run           CatalogSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId    String
  name          String
  /// created | updated
  action        String
  changedFields Json
  before        Json?
  after         Json
  createdAt     DateTime       @default(now())

  @@index([runId, action])
}

// El carrito es personal (dos vendedores del mismo comercio no se pisan) pero
// vive dentro de una organización: si alguien cambia de organización, su carrito
// anterior no lo sigue.
model CartItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  name       String
  price      String
  imageUrl   String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, tenantId, provider, externalId])
  @@index([tenantId])
}

// Borrador de pedido creado en Nodo y enviado al portal del proveedor.
// INVID: el POST de "CONFIRMAR PEDIDO" deja el pedido pendiente.
// NEW_BYTES: POST /carrito/process crea la orden en la cuenta (retiro por defecto).
// `invidOrderNumber` / `invidWebOrderNumber` guardan el nro. externo del proveedor.
model ProviderOrder {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider            String
  status              String
  invidOrderNumber    String?
  invidWebOrderNumber String?
  paymentOption       String
  paymentLabel        String?
  deliveryOption      String?
  deliveryLabel       String?
  notes               String?
  subtotal            Decimal?            @db.Decimal(14, 4)
  impuestos           Decimal?            @db.Decimal(14, 4)
  percepciones        Decimal?            @db.Decimal(14, 4)
  total               Decimal?            @db.Decimal(14, 4)
  errorMessage        String?
  items               Json
  addressSnapshot     Json
  /// ONLINE = checkout al portal. OFFLINE = pedido de Nodo, sin portal, editable.
  channel             String              @default("ONLINE")
  // Aprobación interna del comercio: un vendedor arma el pedido pero no lo
  // confirma; queda en PENDING_APPROVAL hasta que lo aprueba el dueño.
  approvalStatus      OrderApprovalStatus @default(NOT_REQUIRED)
  createdByUserId     String?
  createdBy           User?               @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUserId    String?
  approvedBy          User?               @relation("OrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvalDecidedAt   DateTime?
  rejectionReason     String?
  /// Pedido tal cual lo armó el vendedor. Al aprobarlo se reenvía al proveedor
  /// con estos mismos datos, para que nadie edite lo aprobado por el camino.
  draftInput          Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, provider, createdAt])
  @@index([tenantId, provider, createdAt])
  @@index([tenantId, approvalStatus])
  @@index([approvalStatus])
  @@index([tenantId, channel])
}

enum OrderApprovalStatus {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

