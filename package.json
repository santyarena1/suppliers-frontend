{
  "name": "nodo",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:shared": "pnpm --filter @nodo/shared build",
    "dev:web": "pnpm --filter @nodo/web dev",
    "dev:api": "pnpm build:shared && pnpm --filter @nodo/api start:dev",
    "build:web": "pnpm --filter @nodo/web build",
    "build:api": "pnpm build:shared && pnpm --filter @nodo/api build",
    "test:api": "pnpm build:shared && pnpm --filter @nodo/api test",
    "lint:web": "pnpm --filter @nodo/web lint"
  }
}
