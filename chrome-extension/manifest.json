{
  "manifest_version": 3,
  "name": "NODO – Pedidos INVID",
  "version": "1.0.0",
  "description": "Arma pedidos reales en INVID desde NODO, usando tu propia sesión de invidcomputers.com. Vos confirmás el pedido con el último click, siempre.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.invidcomputers.com/*",
    "https://suppliers-frontend.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suppliers-frontend.vercel.app/*"],
      "js": ["content-nodo.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
