# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# build output
dist/

# production
build/

# uploaded assets (API)
uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# credenciales de entornos anotadas al vuelo
*-admin-password.txt

# vercel
.vercel

# railway
.railway

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# impeccable: evidencia de revisión y referencias descargadas (artefactos, no fuente).
# El surface brief sí se versiona: es el contrato que releen los agentes.
**/.impeccable/review/
**/.impeccable/refs/
**/.impeccable/mocks/
**/.impeccable/build/
.claude/settings.local.json
**/.impeccable/questions/

# Skills instaladas con `npx skills add` / `npx impeccable install`.
# Se reinstalan desde skills-lock.json; pesan ~34 MB y no son fuente del producto.
/.agents/
/.claude/skills/
/.claude/agents/
/.cursor/skills/
/.cursor/agents/
/.cursor/hooks.json
/.github/skills/
/.github/agents/
/.github/hooks/
/.codex/
